# Copy this file to .env and fill in the values
# docker compose will load .env automatically

# Strong password — change before any deployment
DB_PASSWORD=change_this_strong_db_password

# Must be at least 32 random characters — generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-very-long-random-secret-key-min-32-chars

# Admin seed password (min 8 chars, uppercase, digit, special char)
SEED_ADMIN_PASSWORD=Change@Me1234

# Runtime environment — use Production for any public deployment
# Set to Development only for local debugging (enables Swagger UI and DataSeeder)
ASPNETCORE_ENVIRONMENT=Production

# Your domain — Caddy will obtain a Let's Encrypt certificate automatically
# Must be a real public domain pointing to this server (no port, no http://)
DOMAIN=yourdomain.com

# Frontend origin allowed by CORS — must match exactly what the browser sends
# Should be https://<DOMAIN> in production
CORS_ORIGIN=https://yourdomain.com

# Cloudinary (optional — needed only for avatar upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
